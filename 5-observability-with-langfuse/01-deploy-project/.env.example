OPENAI_API_KEY=

## Job search parameters
# Comma-separated job boards. Examples: linkedin,indeed or glassdoor,google
SITE_NAME=linkedin,indeed
# Search area. Examples: USA, Austria, or San Francisco, CA
LOCATION=USA
# Exact country name used by Indeed and Glassdoor. Examples: USA, Austria, or Germany
COUNTRY_INDEED=USA
# Employment type: fulltime, parttime, internship, or contract
JOB_TYPE=fulltime
# Only include jobs posted within this many hours. Examples: 24, 72, or 168
HOURS_OLD=168
# Number of results to retrieve per job board. Examples: 10, 20, or 50
RESULTS_WANTED=25

SEND_EMAIL=true
RESEND_API_KEY=
JOB_AGENT_RECIPIENT_EMAIL=
# JOB_AGENT_SENDER_EMAIL=AI Engineering Job Report <you@your-domain.com>
